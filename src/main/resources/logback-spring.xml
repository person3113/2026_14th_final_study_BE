<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 로그 패턴 설정 (컬러 적용 및 포맷팅) -->
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- 1. Local 콘솔 Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 2. Prod 롤링 파일 Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 일자별 및 크기별 로그 아카이빙 파일 이름 패턴 -->
            <fileNamePattern>logs/archive/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- 로그 파일 하나당 최대 크기 -->
            <maxFileSize>10MB</maxFileSize>
            <!-- 보관 기간 (30일) -->
            <maxHistory>30</maxHistory>
            <!-- 전체 로그 파일 아카이브 용량 한도 -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 프로필에 따른 로깅 레벨 및 Appender 분할 제어 -->

    <!-- Local 환경 -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <!-- 핵심 패키지는 보다 자세한 분석을 위해 DEBUG 레벨 지정 -->
        <logger name="com.example.demo" level="DEBUG"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

    <!-- Production 환경 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.example.demo" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

</configuration>
